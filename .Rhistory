#check for duplicates in both datasets
library(digest)
# Function to create hash for specific columns in each row
hash_function <- function(row) {
columns_to_hash <- colnames(new_dataset)
concatenated <- paste(row[columns_to_hash], collapse = "")
return(digest(concatenated, algo = "sha256"))
}
# Apply the function to each row
new_dataset$hash <- apply(new_dataset, 1, hash_function)
View(new_dataset)
obs_equal$hash <- apply(obs_equal, 1, hash_function)
