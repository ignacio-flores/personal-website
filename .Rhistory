library(furrr)
library(future)
library(magrittr)
library(dplyr)
library(stringr)
library(tidyr)
library(kableExtra)
setwd("~/Dropbox/stats_coordination/wid_all_data/")
plan(multisession, workers = 10)
#list files
meta <- list.files(pattern = "_metadata_", recursive = TRUE)
data <- list.files(pattern = "_data_", recursive = TRUE)
#define data loader function
load_data <- function(path, drop = NULL) {
df <- read.csv(path, header = TRUE, sep = ";", stringsAsFactors = FALSE, colClasses = "character")
if (!is.null(drop)) {
df <- df %>% select(-all_of(drop))
}
df <- df %>%
mutate(
sixlet = str_sub(variable, 1, 6),
onelet = str_sub(sixlet, 1, 1),
twolet = str_sub(sixlet, 2, 3)
) %>% distinct()
return(df)
}
#apply function
allmeta <- future_map_dfr(meta, ~load_data(.x))
