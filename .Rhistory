# Set the directory - these are general to all users and systems
home <- if (.Platform$OS.type == "windows") {
Sys.getenv("USERPROFILE")
} else {
Sys.getenv("HOME")
}
gcw <- file.path(home, "Dropbox", "gcwealth")
warehouse <- file.path(home, "Dropbox", "gcwealth", "output", "databases", "full_warehouse")
documentation <- file.path(home, "Dropbox", "gcwealth", "documentation")
# Code paths
code_eig <- file.path(documentation, "country_sheets", "codes", "eig")
