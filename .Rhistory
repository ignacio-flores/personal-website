library(dplyr)
# 1. Subsample 10% of 'old_whouse'
subsample <- old_whouse %>% sample_frac(0.1)
# 2. Duplicate 0.5% of the subsample
num_duplicated <- round(nrow(subsample) * 0.005)
duplicates <- subsample %>% sample_n(num_duplicated) %>%
mutate(id = row_number()) %>% select(-id)
# 3. Create similar new observations, randomly adjusting 'year' and 'value'
new_similar <- subsample %>%
sample_n(5) %>%
mutate(year = year + sample(-1:1, size = n(), replace = TRUE),
value = value * runif(n(), 0.95, 1.05))
# 4. Add 5 slightly different observations djusting 'value' variable slightly
new_observations <- subsample %>%
sample_n(5) %>%
mutate(value = value * runif(n(), 0.8, 1.2))
# Combine all
new_dataset <- bind_rows(subsample, duplicates, new_similar, new_observations)
rm(subsample, duplicates, new_similar, new_observations)
}
