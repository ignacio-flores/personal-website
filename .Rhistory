source("~/Dropbox/gcwealth/documentation/country_sheets/codes/Master_parent.R")
#Load libraries   - to be modified/added if needed
library(dplyr)
library(stringr)
library(tidyr)
library(knitr)
library(kableExtra)
library(readxl)
library(flextable)
library(haven)
library(ggplot2)
library(marginaleffects)
library(rmarkdown)
# Set the directory - these are general to all users and systems
home <- if (.Platform$OS.type == "windows") {
Sys.getenv("USERPROFILE")
} else {
Sys.getenv("HOME")
}
gcw <- file.path(home, "Dropbox", "gcwealth")
warehouse <- file.path(home, "Dropbox", "gcwealth", "output", "databases", "full_warehouse")
documentation <- file.path(home, "Dropbox", "gcwealth", "documentation")
# Code paths
code_eig <- file.path(documentation, "country_sheets", "codes", "eig")
code_wi <- file.path(documentation, "country_sheets", "codes", "wealth inequality")
code_wt <- file.path(documentation, "country_sheets", "codes", "wealth topography")
## check loop:
library(rmarkdown)
countries <- c("Burkina Faso")
for (country in countries) {
# Build the output directory for this country
out_dir <- file.path(documentation, "country_sheets", "reports", "Burkina Faso")
# Render the Rmd file
render(
input = file.path(documentation, "country_sheets", "codes", "master.Rmd"),
output_file = paste0("report_", country, ".pdf"),
output_dir = out_dir,
params = list(country = country),
knit_root_dir = out_dir, ## remove created empty folders for generated plots
envir = new.env()
)
}
